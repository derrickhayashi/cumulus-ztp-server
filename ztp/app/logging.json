{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "app_logging.UTCFormatter",
      "format": "%(asctime)sZ %(levelname)-7s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "filters": {
    "quiet_polling": {
      "()": "app_logging.QuietPollingFilter"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    },
    "access": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout",
      "filters": [
        "quiet_polling"
      ]
    }
  },
  "loggers": {
    "ztp": {
      "handlers": [
        "stdout"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": [
        "stdout"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": [
        "access"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
