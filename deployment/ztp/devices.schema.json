{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devices.schema.json",
  "title": "Cumulus ZTP device inventory",
  "description": "Device inventory in legacy hostname-keyed format, or with networks and devices sections.",
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname"
      ],
      "anyOf": [
        {
          "required": [
            "eth0_mac"
          ],
          "properties": {
            "eth0_mac": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "serial"
          ],
          "properties": {
            "serial": {
              "type": "string"
            }
          }
        }
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "description": "Switch hostname; this should match the containing object key."
        },
        "mgmt_ip": {
          "description": "Management IPv4 address without a CIDR prefix.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
            }
          ]
        },
        "serial": {
          "description": "Device serial number used when management MAC matching fails.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "eth0_mac": {
          "description": "Management interface MAC address; matching is case-insensitive.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
            }
          ]
        },
        "network": {
          "type": [
            "string",
            "null"
          ],
          "description": "Network name; omitted names are matched by management IP subnet."
        },
        "target_os": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Optional per-switch OS release; omitted or null inherits settings.target_os, then 5.16.0."
        }
      }
    },
    "network": {
      "type": "object",
      "required": [
        "subnet",
        "gateway"
      ],
      "additionalProperties": false,
      "properties": {
        "subnet": {
          "type": "string",
          "description": "IPv4 network in CIDR notation, for example 192.0.2.0/24."
        },
        "gateway": {
          "type": "string",
          "format": "ipv4"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_os": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "authorized_keys": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One SSH public key line. Private keys are not accepted."
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device"
      }
    },
    {
      "type": "object",
      "required": [
        "devices"
      ],
      "additionalProperties": false,
      "properties": {
        "networks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/network"
          }
        },
        "devices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/device"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      },
      "anyOf": [
        {
          "required": [
            "settings"
          ]
        },
        {
          "required": [
            "networks"
          ]
        }
      ]
    }
  ]
}
